# Port d'écoute du serveur
PORT=4000

# Origine autorisée pour les requêtes CORS — URL du site déployé en production.
# En développement local, l'URL de expo start --web fonctionne (souvent http://localhost:8081).
ALLOWED_ORIGIN=https://votre-domaine.com

# Clé API Resend — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Adresse d'expédition : doit appartenir à un domaine vérifié dans Resend.
# En attendant la vérification du domaine mse.cm, onboarding@resend.dev fonctionne pour tester.
MAIL_FROM=MSE CAD Engineering <contact@mse.cm>

# Adresse de réception des demandes du formulaire
MAIL_TO=contact@mse.cm

# Limites d'upload — à garder cohérentes avec src/constants/contactForm.ts côté app
MAX_FILE_SIZE_MB=10
MAX_FILES=10
